# ---- Live fares (optional) ----------------------------------------------
# Free self-service keys from https://developers.amadeus.com
# Without these the app runs on realistic sample data (clearly labelled).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (free sandbox, limited airlines) or "production"
AMADEUS_ENV=test

# ---- Conversational voice agent (optional) ------------------------------
# With a key, spoken requests are understood by Claude (claude-opus-5).
# Without one, a built-in rule-based parser handles the common commands.
ANTHROPIC_API_KEY=

# ---- Defaults (optional) ------------------------------------------------
# Provider to use: "auto" (Amadeus when keys exist, else sample), "amadeus", "sample"
FLIGHT_PROVIDER=auto
# Max concurrent provider calls during a date scan
SCAN_CONCURRENCY=3
