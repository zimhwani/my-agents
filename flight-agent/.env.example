# ---- Live fares (optional) ----------------------------------------------
# Google Flights prices via SerpApi: free key at https://serpapi.com
# Without it the app runs on realistic sample data (clearly labelled).
# Travellers can also paste their own key into the app's "Live fares" panel.
SERPAPI_KEY=

# ---- Conversational voice agent (optional) ------------------------------
# With a key, spoken requests are understood by Claude (claude-opus-5).
# Without one, a built-in rule-based parser handles the common commands.
ANTHROPIC_API_KEY=

# ---- Defaults (optional) ------------------------------------------------
# Provider to use: "auto" (SerpApi when a key exists, else sample), "serpapi", "sample"
FLIGHT_PROVIDER=auto
# Max concurrent provider calls during a date scan
SCAN_CONCURRENCY=3
