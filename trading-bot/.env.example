# ---- Broker ----
# t212 = Trading 212 (default), ib = Interactive Brokers (TWS / IB Gateway)
BROKER=t212
# Currency your UNIVERSE trades in; account equity is converted into it for sizing.
TRADING_CURRENCY=USD

# ---- Trading 212 ----
# Create the key in the app: switch to PRACTICE mode -> Settings -> API
# -> Generate, scopes: account, portfolio, orders (read) + orders (execute).
# You get a KEY and a SECRET; both are required (HTTP Basic auth).
T212_API_KEY=
T212_API_SECRET=
# demo = Practice account (paper), live = real money (also needs LIVE_TRADING_ACK)
T212_ENV=demo
# software = the bot watches the price and sells at market when the stop is hit
#            (the only option on live: Trading 212's live API accepts market orders only)
# broker   = real GTC stop orders at Trading 212 (practice only)
T212_STOP_MODE=software
# Trading 212 has no price feed; bars/quotes come from this provider.
DATA_PROVIDER=yfinance

# ---- Interactive Brokers (only if BROKER=ib) ----
IB_HOST=127.0.0.1
# 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IB_PORT=7497
IB_CLIENT_ID=7
# Leave blank to use the first managed account. Paper accounts start with "DU".
IB_ACCOUNT=
# 1 = live/real-time, 3 = delayed (use 3 if you have no market data subscription)
IB_MARKET_DATA_TYPE=1
# The bot refuses T212_ENV=live or an IB live port unless this is set to exactly:
# I_UNDERSTAND_LIVE_TRADING
LIVE_TRADING_ACK=

# ---- Risk ----
RISK_PER_TRADE_PCT=0.5        # % of net liquidation risked per trade (entry -> stop)
MAX_RISK_PER_TRADE_USD=250    # hard dollar cap per trade
MAX_POSITION_PCT=25           # never put more than this % of equity in one name
MAX_POSITIONS=3
MAX_DAILY_LOSS_R=-3           # stop opening trades after this many R lost today
MAX_DAILY_LOSS_PCT=2          # ...or after equity drops this % from the day's start
ALLOW_SHORTS=false            # must stay false on Trading 212 (long-only)

# ---- Strategy ----
# rules.json = Trend Join Long (gap-and-go, primary); strategy.json = Opening Range Breakout
STRATEGY_FILE=rules.json

# ---- Universe / scan ----
# Trend Join Long scans the market for gappers after the open (Yahoo screener);
# this list is the backtest universe and the fallback if the screener is down.
UNIVERSE_FILE=universe_broad.txt
# Used only when UNIVERSE_FILE is unset or missing:
UNIVERSE=AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,AMD,NFLX,AVGO,CRM,ORCL,JPM,BAC,GS,XOM,CVX,UNH,LLY,COST,WMT,HD,NKE,DIS,BA,CAT,UBER,SHOP,PLTR,COIN,MU,QCOM,INTC,PYPL,ABNB,SMCI,ARM,MRVL,DELL
MIN_PRICE=10
MAX_PRICE=600
MIN_AVG_DOLLAR_VOLUME=50000000
MIN_ATR_PCT=1.0
MAX_WATCHLIST=15

# ---- Loop ----
POLL_SECONDS=30
FORCE_CLOSE_TIME=15:50
DRY_RUN=false                 # true = log orders instead of sending them

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STATUS_MINUTES=30

# ---- Paths ----
DATA_DIR=data
