[Unit]
Description=Trading bot dashboard (localhost only; view via SSH tunnel)
After=network.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/my-agents/trading-bot
ExecStart=/opt/my-agents/trading-bot/.venv/bin/python -m tradebot dashboard --serve 8765 --host 127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
