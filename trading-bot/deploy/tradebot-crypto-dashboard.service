[Unit]
Description=Crypto bot dashboard (localhost:8766; view via SSH tunnel)
After=network.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/my-agents/trading-bot
ExecStart=/opt/my-agents/trading-bot/.venv/bin/python -m tradebot --env .env.crypto dashboard --serve 8766 --host 127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
