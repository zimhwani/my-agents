# Second bot: 24/7 crypto on Alpaca's paper account. Run with:
#   python -m tradebot --env .env.crypto run
BROKER=alpaca
ALPACA_ENV=paper                # live needs LIVE_TRADING_ACK=I_UNDERSTAND_LIVE_TRADING
ALPACA_API_KEY=
ALPACA_API_SECRET=
DATA_PROVIDER=alpaca
STRATEGY_FILE=crypto.json
DATA_DIR=data-crypto            # separate journal, state, dashboard
TRADING_CURRENCY=USD

# Risk (crypto.json sets % per trade, position size and max positions; this is the $ cap)
MAX_RISK_PER_TRADE_USD=1000
EQUITY_CAP_USD=3560          # size as if the paper account held this much (Alpaca paper defaults to $100k)
MAX_DAILY_LOSS_R=-4
MAX_DAILY_LOSS_PCT=5
POLL_SECONDS=30

# Telegram: same bot, messages tagged so you can tell the two apart
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREFIX=CRYPTO
TELEGRAM_STATUS_MINUTES=60

# Hosted dashboard (optional): a second Blob prefix so the two bots don't overwrite each other
VERCEL_BLOB_TOKEN=
VERCEL_BLOB_PREFIX=crypto
DASHBOARD_DATA_URL=https://adnybjtzetdigdeq.public.blob.vercel-storage.com/crypto

# World Monitor news (worldmonitor.app): blocks NEW entries 15 min before to 30 min after
# high-impact US releases (FOMC, CPI, payrolls) and adds headlines/earnings to the watchlist alert.
# News never opens a trade. Without a World Monitor key (worldmonitor.app/pro) the bot uses free sources:
# Forex Factory's weekly calendar and Yahoo Finance RSS headlines.
NEWS_ENABLED=false
WORLDMONITOR_API_KEY=
MACRO_BLACKOUT_BEFORE_MIN=15
MACRO_BLACKOUT_AFTER_MIN=30
