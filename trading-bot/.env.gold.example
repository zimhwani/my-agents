# Gold paper bot: virtual CFD account on live Yahoo gold prices, MT5 copy instructions in every alert.
# Day trading XAUUSD: London/New York hours only, flat by 20:30 UTC. Unvalidated until the gold day
# research ranks it; the slower strategies_cfd/gold_trend_4h.json is the one that passed so far.
BROKER=paper
STRATEGY_FILE=strategies_cfd/gold_day_pullback_15m.json
DATA_DIR=data-gold
DATA_PROVIDER=yfinance
PAPER_EQUITY=10000            # match your Deriv MT5 demo balance so the lot sizes line up
PAPER_FEE_BPS=1.5             # spread cost per side, as in the research
PAPER_STOP_SLIPPAGE_BPS=3
PAPER_CONTRACT_SIZE=100       # MT5 gold: 1 lot = 100 oz
PAPER_LOT_STEP=0.01
MT5_SYMBOLS=XAU/USD=XAUUSD
MAX_RISK_PER_TRADE_USD=1000
MAX_DAILY_LOSS_R=-3
TELEGRAM_PREFIX=GOLD
VERCEL_BLOB_PREFIX=gold
# copied from .env.crypto by the install command:
# TELEGRAM_BOT_TOKEN=  TELEGRAM_CHAT_ID=  VERCEL_BLOB_TOKEN=
