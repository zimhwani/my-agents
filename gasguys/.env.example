# Copy to .env.local and fill in to run the customer web app against a Supabase project ("live mode").
# Leave both empty (or delete the file) and the app runs on the in-browser sandbox instead.
# Find them in the Supabase Dashboard → Project Settings → API. The anon (or publishable) key is safe in
# a browser; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
