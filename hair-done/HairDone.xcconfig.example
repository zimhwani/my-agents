// Copy to HairDone.xcconfig and fill in. It's gitignored.
//
// Same three values as Caddy.xcconfig in the golf-caddy repo: the Team ID is
// the same account, and one App Store Connect API key covers every app on it.
// So: copy the three lines across and rename the prefix.
//
// Team ID: developer.apple.com → Account → Membership, or tools/set_team.sh
// reads it off the signing certificate. Leave empty to build for the
// simulator, which needs no account at all.
HAIRDONE_TEAM_ID =

// Only needed to upload to TestFlight (tools/release.sh). From App Store
// Connect > Users and Access > Integrations > App Store Connect API. The
// matching AuthKey_<KEY_ID>.p8 lives in ~/.appstoreconnect/private_keys and
// is already there if Caddy has shipped from this Mac.
HAIRDONE_ASC_KEY_ID =
HAIRDONE_ASC_ISSUER_ID =

// The backend. With the two Supabase lines filled in the app talks to the live
// project; empty, it runs on its built-in sample data. Both values are public.
// The $() in the URL is on purpose: in an xcconfig, // starts a comment.
HAIRDONE_SUPABASE_URL = https:/$()/yohqeunmgrxyakviofua.supabase.co
HAIRDONE_SUPABASE_KEY = sb_publishable_dDCoMmIEzBXsLRi4itW94g_fNS5KY0s

// Stripe publishable key (pk_test_… first, pk_live_… later): Stripe → Developers → API keys.
// Empty, bookings skip the card step (sample payments). Needs the Stripe package to have resolved.
HAIRDONE_STRIPE_KEY =

// Apple Pay merchant ID, e.g. merchant.com.keithchinyanda.hairdone (docs/go-live.md §2).
// Empty, Apple Pay is left out of the payment sheet and cards still work.
HAIRDONE_MERCHANT_ID =
